# Public production-shaped mobile configuration. For development/preview, use
# the matching non-production API origin and Clerk pk_test_ key instead. EAS
# values belong in the matching Environment, not in a committed .env file.
EXPO_PUBLIC_APP_BASE_URL=https://www.girapphe.com
EXPO_PUBLIC_TERMS_URL=https://www.girapphe.com/terms
EXPO_PUBLIC_PRIVACY_URL=https://www.girapphe.com/privacy
EXPO_PUBLIC_SUPPORT_URL=https://www.girapphe.com/support
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://www.girapphe.com/account/delete
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# Superwall public SDK keys. Girapphe renders its own subscription screen; the
# SDK is used only for native product loading, purchase, restore, and local
# status. The Girapphe server remains authoritative for `ad_free`.
EXPO_PUBLIC_SUPERWALL_IOS_API_KEY=pk_...
EXPO_PUBLIC_SUPERWALL_ANDROID_API_KEY=pk_...
EXPO_PUBLIC_SUPERWALL_IOS_MONTHLY_PURCHASE_IDENTIFIER=com.girapphe.plus.monthly
EXPO_PUBLIC_SUPERWALL_IOS_ANNUAL_PURCHASE_IDENTIFIER=com.girapphe.plus.annual
# Billing V1 requires the exact Play selector product:base-plan:sw-none. The
# `sw-none` segment prevents an introductory offer or free trial from being chosen.
EXPO_PUBLIC_SUPERWALL_ANDROID_MONTHLY_PURCHASE_IDENTIFIER=girapphe_plus_monthly:monthly:sw-none
EXPO_PUBLIC_SUPERWALL_ANDROID_ANNUAL_PURCHASE_IDENTIFIER=girapphe_plus_annual:annual:sw-none

# This client gate and the independent server gate must both be true before the
# app offers a new purchase. Keep false until sandbox/store evidence is recorded.
EXPO_PUBLIC_MOBILE_BILLING_ACQUISITION_ENABLED=false

# AdMob app IDs are consumed by app.config.ts at native build time.
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-...~...
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-...~...

# Native ad unit IDs are used only in production. Development always uses
# Google's official NativeAd test unit through TestIds.NATIVE.
EXPO_PUBLIC_ADMOB_IOS_NATIVE_UNIT_ID=ca-app-pub-.../...
EXPO_PUBLIC_ADMOB_ANDROID_NATIVE_UNIT_ID=ca-app-pub-.../...
