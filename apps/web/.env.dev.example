# Development Environment Template
# Copy to .env.local for local development:
#   cp .env.dev.example .env.local

# App
APP_BASE_URL=http://localhost:3000

# Clerk (use test keys in dev; do not use live keys locally)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/practice
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/practice

# Database (optional in dev; uncomment only with a real isolated database)
# DATABASE_URL=postgres://user:password@host/dev_db?sslmode=require

# Optional: caps how many graph-derived knowledge cards are generated.
# Default 600. Set 1000+ if you expand GRAPH_NODES and want more cards.
KNOWLEDGE_CARD_LIMIT=600

# Optional: total seeded/practice card pool size (includes hidden drill cards).
# Default 1000. Increase if you add more content sources.
CARD_POOL_SIZE=1000

# Admin routes (required only for /admin access)
ADMIN_CLERK_USER_ID=user_...

# Optional web subscription (Stripe test mode). Uncomment the complete group.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_AD_FREE_MONTHLY=price_...
# STRIPE_PRICE_AD_FREE_ANNUAL=price_...

# Optional mobile entitlement webhook/reconciliation. Uncomment the complete group.
# REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer replace_me
# REVENUECAT_WEBHOOK_SIGNING_SECRET=replace_me
# REVENUECAT_APP_IDS=app_ios_...,app_android_...
# REVENUECAT_SECRET_API_KEY=sk_...
# REVENUECAT_PRODUCT_AD_FREE_MONTHLY_IDS=ios.monthly,android.monthly
# REVENUECAT_PRODUCT_AD_FREE_ANNUAL_IDS=ios.annual,android.annual

# AdSense is production-only. Local development always exercises the house card.

# Optional Korean card recurring billing. Uncomment the complete group only after setup.
# NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
# TOSS_SECRET_KEY=test_sk_...
# TOSS_BILLING_ENCRYPTION_KEY=replace_me
# TOSS_MONTHLY_AMOUNT_KRW=1400
# TOSS_ANNUAL_AMOUNT_KRW=14000
# TOSS_BILLING_CRON_TOKEN=replace_me
