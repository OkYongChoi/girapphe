# Development Environment Template
# Copy to .env.local for local development:
#   cp .env.dev.example .env.local

# App
APP_BASE_URL=http://localhost:3000

# Clerk (use test keys in dev; do not use live keys locally)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/practice
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/practice

# Database (optional in dev; uncomment only with a real isolated database)
# DATABASE_URL=postgres://user:password@host/dev_db?sslmode=require

# Optional: caps how many graph-derived knowledge cards are generated.
# Default 600. Set 1000+ if you expand GRAPH_NODES and want more cards.
KNOWLEDGE_CARD_LIMIT=600

# Optional: total seeded/practice card pool size (includes hidden drill cards).
# Default 1000. Increase if you add more content sources.
CARD_POOL_SIZE=1000

# Optional WebMCP Chrome Origin Trial token. Local flag-based testing does not
# require this value; leave it unset unless this exact origin is enrolled.
# NEXT_PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN=replace_with_origin_trial_token

# Admin routes (required only for /admin access)
ADMIN_CLERK_USER_ID=user_...

# Optional admin capacity dashboard. Leave both groups absent for configuration-safe states.
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_ANALYTICS_API_TOKEN=...
# NEON_API_KEY=...
# NEON_PROJECT_ID=...
# NEON_BRANCH_ID=...
# The Worker detects pooling from DATABASE_URL; use Neon pooled URLs in production.

# New acquisition is gated separately from provider lifecycle processing. Keep
# both gates false until the applicable sandbox evidence is complete.
WEB_BILLING_ACQUISITION_ENABLED=false
MOBILE_BILLING_ACQUISITION_ENABLED=false

# Creem test lifecycle group. Configure all four values together so webhooks,
# reconciliation, management, and cancellation can keep working while the gate is false.
# CREEM_API_KEY=replace_me
# CREEM_WEBHOOK_SECRET=replace_me
# CREEM_ANNUAL_PRODUCT_ID=replace_me
# CREEM_ENVIRONMENT=test

# Superwall test server lifecycle group. Mobile public SDK/product values are
# configured separately in the Expo environment; no server secret belongs in a build.
# SUPERWALL_ORGANIZATION_API_KEY=replace_me
# SUPERWALL_WEBHOOK_SECRET=whsec_replace_me
# SUPERWALL_PROJECT_ID=replace_me
# SUPERWALL_ENVIRONMENT=test
# SUPERWALL_IOS_APPLICATION_ID=replace_me
# SUPERWALL_ANDROID_APPLICATION_ID=replace_me
# SUPERWALL_IOS_BUNDLE_ID=com.girapphe.app
# SUPERWALL_ANDROID_PACKAGE_ID=com.girapphe.app
# SUPERWALL_IOS_MONTHLY_PRODUCT_ID=replace_me
# SUPERWALL_IOS_ANNUAL_PRODUCT_ID=replace_me
# SUPERWALL_ANDROID_MONTHLY_PRODUCT_ID=replace_me
# SUPERWALL_ANDROID_ANNUAL_PRODUCT_ID=replace_me

# AdSense is production-only. Local development always exercises the house card.
