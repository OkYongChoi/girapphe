# PR Preview Environment Template
# These values are injected by GitHub Actions. Do not create a persistent local file from this template.

# App (the workflow derives the exact PR URL at deploy time)
APP_BASE_URL=https://pr-123-girapphe-preview.example.workers.dev

# Clerk (use a separate development/preview Clerk instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/practice
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/practice

# Database (required; must be an isolated Neon preview branch/database)
DATABASE_URL=postgres://user:password@host/preview_db?sslmode=require

# Optional WebMCP Chrome Origin Trial token issued for this preview origin.
# NEXT_PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN=replace_with_origin_trial_token

# Optional monetization QA. Use provider test/sandbox resources only and
# uncomment each complete group together.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_AD_FREE_MONTHLY=price_...
# STRIPE_PRICE_AD_FREE_ANNUAL=price_...
# REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer replace_me
# REVENUECAT_WEBHOOK_SIGNING_SECRET=replace_me
# REVENUECAT_APP_IDS=app_ios_...,app_android_...
# REVENUECAT_SECRET_API_KEY=sk_...
# REVENUECAT_PRODUCT_AD_FREE_MONTHLY_IDS=ios.monthly,android.monthly
# REVENUECAT_PRODUCT_AD_FREE_ANNUAL_IDS=ios.annual,android.annual
TOSS_BILLING_ENABLED=false
# This release rejects true and keeps a runtime safety fuse closed. Use the test-only
# harness for lifecycle tests; a later activation PR must keep other providers absent.
# NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
# TOSS_SECRET_KEY=test_sk_...
# TOSS_BILLING_ENCRYPTION_KEY=replace_me
# TOSS_MONTHLY_AMOUNT_KRW=1400
# TOSS_ANNUAL_AMOUNT_KRW=14000
# TOSS_BILLING_CRON_TOKEN=replace_me
