# Production Environment Template
# Use these values in Cloudflare Worker env/secrets and CI variables/secrets.

# App
APP_BASE_URL=https://www.girapphe.com

# Clerk (must be live keys in prod)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Clerk routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/practice
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/practice

# Database (required in prod)
DATABASE_URL=postgres://user:password@host/prod_db?sslmode=require

# Admin routes (set to the Clerk user id allowed to access /admin)
ADMIN_CLERK_USER_ID=user_...

# Required for the daily permanent-deletion job. Store the real value only as
# the PERSONAL_KNOWLEDGE_PURGE_TOKEN GitHub and Cloudflare Worker secret.
PERSONAL_KNOWLEDGE_PURGE_TOKEN=replace_me

# Optional Stripe web subscriptions: uncomment the complete group after creating
# Optional admin capacity dashboard. Configure each group together to activate live signals.
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_ANALYTICS_API_TOKEN=...
# NEON_API_KEY=...
# NEON_PROJECT_ID=...
# NEON_BRANCH_ID=...
# The Worker detects pooling from DATABASE_URL; use Neon pooled URLs in production.

# $1 monthly and $10 annual recurring prices. The app applies one shared trial.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_AD_FREE_MONTHLY=price_...
# STRIPE_PRICE_AD_FREE_ANNUAL=price_...

# Optional RevenueCat production reconciliation. Uncomment the complete group.
# REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer replace_me
# REVENUECAT_WEBHOOK_SIGNING_SECRET=replace_me
# REVENUECAT_APP_IDS=app_ios_...,app_android_...
# REVENUECAT_SECRET_API_KEY=sk_...
# REVENUECAT_PRODUCT_AD_FREE_MONTHLY_IDS=ios.monthly,android.monthly
# REVENUECAT_PRODUCT_AD_FREE_ANNUAL_IDS=ios.annual,android.annual

# Optional AdSense practice card. Uncomment all three values together.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-...
# NEXT_PUBLIC_ADSENSE_PRACTICE_SLOT_ID=1234567890
# NEXT_PUBLIC_ADSENSE_CONSENT_READY=true

# Optional Toss Payments domestic-card recurring billing. Credentials alone never
# enable it. This release rejects true and keeps a runtime safety fuse closed.
TOSS_BILLING_ENABLED=false
# A later reviewed activation PR may open it only after the full drill and with Stripe
# and RevenueCat server groups absent. Amounts are integer KRW.
# NEXT_PUBLIC_TOSS_CLIENT_KEY=live_ck_...
# TOSS_SECRET_KEY=live_sk_...
# TOSS_BILLING_ENCRYPTION_KEY=replace_me
# TOSS_MONTHLY_AMOUNT_KRW=1400
# TOSS_ANNUAL_AMOUNT_KRW=14000
# TOSS_BILLING_CRON_TOKEN=replace_me
