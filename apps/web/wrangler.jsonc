{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "girapphe",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-16",
  "minify": true,
  "limits": {
    "subrequests": 250
  },
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "base"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "env": {
    "preview": {
      "name": "girapphe-preview",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "APP_ENV": "preview"
      },
      "ai": {
        "binding": "AI"
      }
    },
    "prod": {
      "name": "girapphe",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "girapphe.com/*",
          "zone_name": "girapphe.com"
        },
        {
          "pattern": "www.girapphe.com/*",
          "zone_name": "girapphe.com"
        }
      ],
      "vars": {
        "APP_ENV": "prod"
      },
      "ai": {
        "binding": "AI"
      }
    }
  }
}
