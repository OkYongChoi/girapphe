{
  "name": "stem-brain",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "pnpm --filter @stem-brain/web build",
    "build:web": "pnpm --filter @stem-brain/web build",
    "build:all": "turbo build",
    "build:cf": "pnpm --filter @stem-brain/web build:cf",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "check": "turbo check",
    "env:setup:dev": "pnpm --filter @stem-brain/web env:setup:dev",
    "check:env:dev": "pnpm --filter @stem-brain/web check:env:dev",
    "check:env:prod": "pnpm --filter @stem-brain/web check:env:prod",
    "check:env:examples": "pnpm --filter @stem-brain/web check:env:examples",
    "check:docs": "node --test scripts/check-docs.test.mjs && node scripts/check-docs.mjs",
    "check:plugin": "node --test scripts/check-codex-plugin.test.mjs && node scripts/check-codex-plugin.mjs",
    "db:generate": "pnpm --filter @stem-brain/web db:generate",
    "db:migrate": "pnpm --filter @stem-brain/web db:migrate",
    "db:studio": "pnpm --filter @stem-brain/web db:studio",
    "smoke": "pnpm --filter @stem-brain/web smoke",
    "browser:smoke": "playwright test",
    "browser:smoke:headed": "playwright test --headed",
    "browser:authenticated-overlay": "PLAYWRIGHT_NO_COPY_PROMPT=1 playwright test --config=playwright.authenticated.config.ts; playwright_status=$?; node apps/web/scripts/summarize-authenticated-overlay-results.mjs; summary_status=$?; if [ \"$playwright_status\" -ne 0 ]; then exit \"$playwright_status\"; fi; exit \"$summary_status\"",
    "browser:authenticated-overlay:summary": "node apps/web/scripts/summarize-authenticated-overlay-results.mjs",
    "check:worker-size": "node --test scripts/check-worker-size.test.mjs && node scripts/check-worker-size.mjs",
    "verify:image-size-hardening": "node scripts/verify-image-size-hardening.mjs",
    "harness": "pnpm harness:local",
    "harness:local": "pnpm check && pnpm check:docs && pnpm check:plugin && pnpm verify:image-size-hardening && pnpm --filter @stem-brain/web check:env:examples && pnpm --filter @stem-brain/web build",
    "harness:browser": "pnpm harness:local && pnpm browser:smoke",
    "harness:ci": "pnpm harness:local && pnpm --filter @stem-brain/mobile build",
    "harness:deploy": "pnpm harness:local && pnpm build:cf && pnpm check:worker-size"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "github-slugger": "^2.0.0",
    "js-yaml": "^4.3.1",
    "parse5": "^8.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "turbo": "^2.5.4",
    "typescript": "6.0.3",
    "unified": "^11.0.5"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@babel/core": "^7.29.7",
      "lodash-es": "^4.18.1",
      "node-forge": "^1.4.0",
      "postcss": "^8.5.18",
      "shell-quote": "^1.8.4",
      "sharp": "^0.35.0",
      "tar": "^7.5.19",
      "@xmldom/xmldom": "^0.8.13",
      "js-yaml": "^4.3.1",
      "@react-native/dev-middleware>ws": "^7.5.13",
      "metro>ws": "^7.5.13",
      "react-devtools-core>ws": "^7.5.13",
      "uuid": "^11.1.1"
    },
    "patchedDependencies": {
      "image-size@1.2.1": "patches/image-size@1.2.1.patch",
      "expo-superwall@1.3.0": "patches/expo-superwall@1.3.0.patch"
    },
    "packageExtensions": {
      "@clerk/expo@*": {
        "dependencies": {
          "@expo/config-plugins": "~57.0.0"
        }
      }
    }
  }
}
